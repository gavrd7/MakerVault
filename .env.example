# MakerVault v1.7.0 — example configuration
# On a NEW installation: python3 scripts/generate_env_secrets.py
# Keep your own .env when updating. NEVER commit real secrets.

# --- Web and regional settings ---
TZ=Europe/London
DJANGO_TIME_ZONE=Europe/London
DJANGO_LANGUAGE_CODE=en-gb
MAKERVAULT_CURRENCY=GBP
MAKERVAULT_MEASUREMENT_SYSTEM=metric
MAKERVAULT_PORT=8765

# Replace these with the server's actual IP/hostname and browser address.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8765
DJANGO_DEBUG=false
TRUST_PROXY_HEADERS=false
ALLAUTH_TRUSTED_PROXY_COUNT=0

# --- Security credentials ---
# The setup script generates all four secrets below automatically.
DJANGO_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MAKERVAULT_SLICER_WORKER_TOKEN=CHANGE_ME_SLICER_WORKER_TOKEN
MAKERVAULT_SLICER_INSTALLER_TOKEN=CHANGE_ME_SLICER_INSTALLER_TOKEN

# --- Database and internal services ---
POSTGRES_DB=makervault
POSTGRES_USER=makervault
DATABASE_HOST=postgres
DATABASE_PORT=5432
REDIS_URL=redis://redis:6379/0

# --- MakerVault Slicer ---
# A separate makervault-slicer container starts with the normal Compose stack.
# All slicer engines are installed or switched through MakerVault's engine manager.
# Before enabling real slicing, check the worker identity and approved native
# engine checksums as explained in the dedicated slicer installation guide.
MAKERVAULT_SLICER_PREVIEW_ENABLED=1
MAKERVAULT_SLICER_EXECUTION_ENABLED=1
MAKERVAULT_SLICER_HOST_UPDATER_ENABLED=1
# Optional: pin a reviewed immutable combined worker image after publication.
# MAKERVAULT_SLICER_WORKER_IMAGE=ghcr.io/gavrd7/makervault-slicer:1.7.0
# The older makervault-slicer:0.1.0 image is NOT compatible.
# Release gate: the final published combined worker SHA-256 must be pinned
# here AND in MAKERVAULT_SLICER_WORKER_IMAGE before v1.7.0 is published.
# The administrator engine manager maintains individual native engine approvals;
# no per-engine JSON configuration is required for normal operation.
# MAKERVAULT_SLICER_WORKER_IMAGE=ghcr.io/gavrd7/makervault-slicer@sha256:<release-digest>
# MAKERVAULT_SLICER_ENGINE_IMAGE_DIGEST=sha256:<same-release-digest>
# See docs/guide/3d-printing/slicer.md for release pinning and safe upgrades.

# --- Persistent storage ---
MEDIA_STORAGE=makervault_media
KEY_STORAGE=makervault_keys
POSTGRES_STORAGE=makervault_postgres
REDIS_STORAGE=makervault_redis
BACKUP_STORAGE=makervault_backups

# --- Optional settings (uncomment only if required) ---
# Storage permissions: PUID=1000, PGID=1000, UMASK=0022
# Pin application image: MAKERVAULT_IMAGE=ghcr.io/gavrd7/makervault:1.7.0
# Bind MakerVault to a LAN interface: MAKERVAULT_BIND_ADDRESS=192.168.1.10
# Native HTTPS: MAKERVAULT_HTTPS_ENABLED=auto
# HTTPS cert/key: MAKERVAULT_TLS_CERT_FILE=/app/keys/tls/cert.pem
# HTTPS cert/key: MAKERVAULT_TLS_KEY_FILE=/app/keys/tls/key.pem
# WebRTC camera media: MAKERVAULT_WEBRTC_CANDIDATE=stun:8555
# SMTP: EMAIL_HOST=, EMAIL_PORT=587, EMAIL_HOST_USER=, EMAIL_HOST_PASSWORD=
# New account signups: ALLOW_LOCAL_REGISTRATION=false
# OIDC: OIDC_ENABLED=false
# See docs/guide/reference/configuration.md for all optional settings.
