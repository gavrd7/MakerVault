# MakerVault v0.6.0.3 environment
# Copy to .env before first launch.

# ---------- Locale / time ----------
TZ=Europe/London
DJANGO_TIME_ZONE=Europe/London
DJANGO_LANGUAGE_CODE=en-gb
MAKERVAULT_CURRENCY=GBP
MAKERVAULT_MEASUREMENT_SYSTEM=metric

# ---------- Container permissions ----------
# Set these to the Linux user/group that should own MakerVault media on bind mounts.
PUID=1000
PGID=1000
UMASK=0022
# If true, MakerVault fixes ownership of its writable app/media directories at startup.
FIX_PERMISSIONS=true

# ---------- Storage ----------
# Each source can be EITHER a Docker named volume OR an absolute host path.
# Named-volume example:
MEDIA_STORAGE=makervault_media
POSTGRES_STORAGE=makervault_postgres
REDIS_STORAGE=makervault_redis
# Bind-mount example (uncomment/replace the three lines above):
# MEDIA_STORAGE=/mnt/Server/MakerVault/media
# POSTGRES_STORAGE=/mnt/Server/MakerVault/postgres
# REDIS_STORAGE=/mnt/Server/MakerVault/redis

# ---------- Web / security ----------
# Host-side port published by Docker. The application remains on port 8000
# inside the Docker network; normally only this host-side value needs changing.
MAKERVAULT_BIND_ADDRESS=0.0.0.0
MAKERVAULT_PORT=8765
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
# Comma-separated hostnames/IPs accepted by Django.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated full origins; include scheme. Add your reverse-proxy URL here.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8765
# Set true once serving only through HTTPS/reverse proxy.
DJANGO_SECURE_COOKIES=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_HSTS_SECONDS=0
TRUST_PROXY_HEADERS=true
# Keep false unless your reverse proxy rewrites Host and you explicitly trust its X-Forwarded-Host header.
TRUST_X_FORWARDED_HOST=false
# Number of trusted reverse proxies in front of MakerVault for allauth rate-limit IP detection.
# Keep 0 for direct local access; set 1 for a single trusted reverse proxy.
ALLAUTH_TRUSTED_PROXY_COUNT=0

# Registration is off by default. Admins can create users, and OIDC can create users.
ALLOW_LOCAL_REGISTRATION=false

# ---------- Initial admin (optional) ----------
# If password is non-empty, startup creates/updates this superuser.
MAKERVAULT_ADMIN_USERNAME=admin
MAKERVAULT_ADMIN_EMAIL=
MAKERVAULT_ADMIN_PASSWORD=

# ---------- Generic OIDC client (optional bootstrap) ----------
# This remains useful for immutable/server-managed configuration. Administrators
# can also add database-backed OIDC providers from Account & Security -> Identity providers.
OIDC_ENABLED=false
OIDC_PROVIDER_ID=oidc
OIDC_PROVIDER_NAME=OpenID Connect
OIDC_SERVER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_FETCH_USERINFO=true
OIDC_PKCE=true
OIDC_AUTO_SIGNUP=true
# Keep false for Internet-facing deployments. Set true only when an intentionally
# configured lab/internal OIDC provider cannot offer HTTPS.
OIDC_ALLOW_INSECURE_ISSUERS=false

# ---------- Email (optional) ----------
# If EMAIL_HOST is empty, email is disabled rather than writing reset links to logs.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=MakerVault <makervault@localhost>

# ---------- PostgreSQL ----------
POSTGRES_DB=makervault
POSTGRES_USER=makervault
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_CONN_MAX_AGE=60

# ---------- Board technical catalogue enrichment ----------
# Server-level master switch. Scheduling is configured in the admin Settings UI.
ENRICH_BOARD_CATALOGUE=true
BOARD_ENRICHMENT_MAX_PER_RUN=500
BOARD_ENRICHMENT_RETRY_DAYS=14

# ---------- 3D printer catalogue ----------
# Expand/refresh printer model names from OrcaSlicer's AGPL-3.0 profile manifests.
# Existing populated MakerVault specifications are never overwritten.
SYNC_ORCASLICER_PRINTER_CATALOGUE=true
ORCASLICER_PRINTER_CATALOGUE_REF=main

# ---------- Catalogue images ----------
# Server-level master switch. Scheduling is configured in the admin Settings UI.
# Wikimedia Commons is the default automatic source and is restricted to
# CC0/Public Domain, CC BY and CC BY-SA raster media. ESPBoards artwork is
# CC BY-NC 4.0, so automatic ESPBoards image caching is OFF by default.
# Enable it only for a non-commercial deployment after reviewing its terms.
SEED_CATALOGUE_IMAGES=true
CATALOGUE_IMAGE_MAX_PER_RUN=60
CATALOGUE_IMAGE_RETRY_DAYS=7
CATALOGUE_IMAGE_PREFER_ESPBOARDS=false
CATALOGUE_IMAGE_WIKIMEDIA=true
# Second open-licence search source used when Commons has no confident match.
CATALOGUE_IMAGE_OPENVERSE=true

# ---------- Filament catalogue ----------
# Optional public catalogue used by the 3D Printing filament browser.
# Leave the default to use the official SpoolmanDB feed.
FILAMENT_CATALOGUE_SPOOLMANDB_URL=https://donkie.github.io/SpoolmanDB/filaments.json

# ---------- Redis / worker ----------
REDIS_URL=redis://redis:6379/0
CELERY_CONCURRENCY=2
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=120

# ---------- Upload limits ----------
# Django request-body limit, in bytes (default 1 GiB to allow CAD/3MF archives).
# 64 MiB recommendation for the current UI. Raise deliberately when large CAD uploads are implemented.\nDATA_UPLOAD_MAX_MEMORY_SIZE=67108864
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
