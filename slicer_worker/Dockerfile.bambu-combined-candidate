# Disposable four-container-base compatibility proof; NOT a deployable release.
# Use the same immutable reviewed Orca image that currently underlies
# MakerVault's combined worker/installer. Never replace the live image.
FROM ghcr.io/gavrd7/makervault-slicer-orca@sha256:7f12df990d059d6a5e889c3cff6ebacd3a7c627fee28ff75e8696bee9c3423f4
USER root
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      libgstreamer-plugins-base1.0-0 libwebkit2gtk-4.1-0 \
      libjavascriptcoregtk-4.1-0 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --chown=10001:10001 slicer_worker/ /opt/makervault-slicer/slicer_worker/
COPY --from=bambu-verified-assets /bambustudio.AppImage /opt/bambu-candidate/bambustudio.AppImage
RUN echo '668dabb1be53c758189ed6bc89935285dea5e0af46216546b1bafd6882e9aff0  /opt/bambu-candidate/bambustudio.AppImage' \
      | sha256sum --check --status && \
    cd /opt/bambu-candidate && \
    chmod 0555 bambustudio.AppImage && \
    ./bambustudio.AppImage --appimage-extract >/dev/null && \
    test -x squashfs-root/AppRun && \
    chmod -R a+rX squashfs-root && \
    python3 -m compileall -q /opt/makervault-slicer/slicer_worker
ENV PYTHONPATH=/opt/makervault-slicer PYTHONDONTWRITEBYTECODE=1
USER 10001:10001
CMD ["python3", "-m", "slicer_worker.probe", "--help"]
